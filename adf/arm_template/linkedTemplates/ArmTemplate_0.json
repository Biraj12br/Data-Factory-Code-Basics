                "activities": [
                    {
                        "name": "Copy hotels file",
                        "type": "Copy",
                        "dependsOn": [],
                        "policy": {
                            "timeout": "0.3:00:00",
                            "retry": 1,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [
